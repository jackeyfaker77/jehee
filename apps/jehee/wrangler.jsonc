{
	"name": "jehee-bot",
	"main": "./worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"JEHEE_MODEL": "opencode-go/deepseek-v4.1-flash",
		"JEHEE_MEMORY_PROVIDER": "atomic",
		"JEHEE_MEMORY_CONSOLIDATION_IDLE_MS": "600000",
		"JEHEE_TZ_OFFSET": "+08:00",
		"JEHEE_QUIET_HOURS": "23:00-08:00"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "JEHEE_DO",
				"class_name": "JeheeSessionDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["JeheeSessionDO"]
		}
	]
}
