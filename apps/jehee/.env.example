# ============================================================================
# 1. 模型与提供商密钥（默认使用 OpenCode Go）
# 可运行 `npm --prefix apps/jehee run jehee -- models opencode-go` 查看全部可用模型
# 常见可选：
#   opencode-go/glm-5.3-flash
#   opencode-go/glm-5.3
#   opencode-go/kimi-k3.1-pro
#   opencode-go/kimi-k2.7-code
#   opencode-go/deepseek-v4.1-flash
#   opencode-go/gpt-6-luna
#   opencode-go/claude-haiku-5-5
# ============================================================================
JEHEE_MODEL=opencode-go/glm-5.3-flash
OPENCODE_API_KEY=

# 其他可选备用模型厂商密钥（按需填写）
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# ============================================================================
# 2. 核心长期画像（L1 Core Memory 初始静态提示）
# ============================================================================
JEHEE_CORE_MEMORY=回答简洁直接，工程任务优先派发工坊在独立目录执行。

# ============================================================================
# 3. Telegram 渠道配置
# TELEGRAM_ALLOWED_USERS 填写你自己的 Telegram 数字 User ID（多个用逗号分隔）
# ============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_WEBHOOK_SECRET=

# 可选：连发消息防抖合并窗口（毫秒，本地长轮询推荐 600，Webhook 可设 0）
JEHEE_DEBOUNCE_MS=600

# 可选：Staging 发送保护锁（设置后仅允许发往指定 route，例如 telegram:123456789）
# JEHEE_STAGING_ROUTES=

# ============================================================================
# 4. 可选：InstaBox 免费版云工坊（4C8G 单机按需唤醒 + /data/jehee/worktrees 多目录隔离）
# 留空则不挂载远程云工坊
# ============================================================================
INSTABOX_API_KEY=
INSTABOX_MACHINE_ID=
# INSTABOX_WORKTREES_ROOT=/data/jehee/worktrees
