# ============================================================================
# 1. 模型与提供商密钥（默认使用 OpenCode Go）
# 可运行 `npm --prefix apps/jehee run jehee -- models opencode-go` 查看全部可用模型
# 常见可选：
#   opencode-go/glm-5.3-flash
#   opencode-go/glm-5.3
#   opencode-go/kimi-k3.1-pro
#   opencode-go/kimi-k2.7-code
#   opencode-go/deepseek-v4.1-flash
#   opencode-go/gpt-6-luna
#   opencode-go/claude-haiku-5-5
# ============================================================================
JEHEE_MODEL=opencode-go/glm-5.3-flash
OPENCODE_API_KEY=

# 其他可选备用模型厂商密钥（按需填写）
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# ============================================================================
# 2. 核心长期画像（L1 Core Memory 初始静态提示）
# ============================================================================
JEHEE_CORE_MEMORY=回答简洁直接，工程任务优先派发工坊在独立目录执行。

# ============================================================================
# 3. Telegram 渠道配置
# TELEGRAM_ALLOWED_USERS 填写你自己的 Telegram 数字 User ID（多个用逗号分隔）
# ============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_WEBHOOK_SECRET=

# 可选：连发消息防抖合并窗口（毫秒，本地长轮询推荐 600，Webhook 可设 0）
JEHEE_DEBOUNCE_MS=600

# 可选：Staging 发送保护锁（设置后仅允许发往指定 route，例如 telegram:123456789）
# JEHEE_STAGING_ROUTES=

# ============================================================================
# 4. 工坊与外部 Coding Agent 网关配置（Slice 5B — 支持云端 InstaBox 或本机 Git Worktree）
# JEHEE_WORKSHOP_DRIVER 可选：opencode | antigravity | pi | claude | codex | custom | builtin
# 本地跑 start:telegram / start:cli 时，可设 JEHEE_WORKSHOP_LOCAL_ROOT 直接在本机拉隔离分支干活；
# 云端跑 Cloudflare Workers 时，配置 INSTABOX_API_KEY + INSTABOX_MACHINE_ID 远程执行。
# ============================================================================
# JEHEE_WORKSHOP_DRIVER=antigravity
# JEHEE_WORKSHOP_AGENT_MODEL=
# JEHEE_WORKSHOP_LOCAL_ROOT=E:/CODE/.jehee-worktrees
# JEHEE_WORKSHOP_DEFAULT_REPO=E:/CODE/jehee
INSTABOX_API_KEY=
INSTABOX_MACHINE_ID=
# INSTABOX_WORKTREES_ROOT=/data/jehee/worktrees

# ============================================================================
# 5. 可选：MCP 连接器配置（对齐 Claude / Codex / pi 的 mcpServers 标准结构）
# 本地运行默认自动读取同目录下的 `apps/jehee/mcp.json`（可参考 `mcp.example.json`），
# 也可通过 `JEHEE_MCP_CONFIG` 指定路径，或用 `JEHEE_MCP_SERVERS` 内联 JSON（Cloudflare Workers 使用后者）。
# 可运行 `npm --prefix apps/jehee run jehee -- mcp` 一键验证握手与工具列表。
# ============================================================================
# JEHEE_MCP_EXPOSURE=deferred
# JEHEE_MCP_CONFIG=
# JEHEE_MCP_SERVERS={"mcpServers":{"docs":{"url":"https://example.com/mcp","headers":{"Authorization":"Bearer ${DOCS_TOKEN}"}}}}

# ============================================================================
# 6. 安全审批与主动打扰治理（Slice 5A — "It knows when to be quiet"）
# JEHEE_MCP_WRITE_GATE=confirm-writes 开启非只读 MCP 工具的人工确认门控（支持 Telegram 按钮与 /approve）
# JEHEE_MCP_WRITE_EXEMPT 可选豁免白名单（例如 calendar/calendar.import_ics）
# JEHEE_QUIET_HOURS 静默免打扰时段（24 小时制，期间普通后台通知自动暂存，交互或 /flush 时补发）
# ============================================================================
JEHEE_MCP_WRITE_GATE=confirm-writes
# JEHEE_MCP_WRITE_EXEMPT=
# JEHEE_QUIET_HOURS=23:00-08:00
# JEHEE_TZ_OFFSET=+08:00
# JEHEE_PROACTIVE_COOLDOWN_MS=30000
